+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SUNPATHS Self-Test</title><link rel="stylesheet" href="./app/styles.css"></head>
+<body><main class="page"><header class="page-header"><div><p class="eyebrow">Developer check</p><h1>SUNPATHS self-test</h1><p>Runs the real rules engine through static GitHub hosting.</p></div><a class="button ghost" href="./index.html">Open game</a></header><section class="panel"><button id="run" class="primary">Run tests</button><p id="summary" aria-live="polite">Not run yet.</p><div id="results"></div></section></main>
+<script type="module">
+import { runSelfTests } from "./tests/selfTest.js";
+const button=document.getElementById("run"), summary=document.getElementById("summary"), results=document.getElementById("results");
+function run(){ button.disabled=true; summary.textContent="Running…"; setTimeout(()=>{ const report=runSelfTests(); summary.textContent=`${report.passed} passed · ${report.failed} failed`; results.innerHTML=""; for(const item of report.results){ const row=document.createElement("p"); row.className=item.passed?"notice":"notice error"; row.textContent=`${item.passed?"PASS":"FAIL"} — ${item.name}${item.message?`: ${item.message}`:""}`; results.appendChild(row); } button.disabled=false; },20); }
+button.addEventListener("click",run); run();
+</script></body></html>
